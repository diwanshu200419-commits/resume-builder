NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
GEMINI_API_KEY=your-gemini-api-key

# UPI payment config (Google Pay, PhonePe, Paytm, etc.)
NEXT_PUBLIC_UPI_ID=yourname@upi
NEXT_PUBLIC_UPI_NAME=Your Name
NEXT_PUBLIC_APP_URL=https://www.vayloai.online

# REQUIRED: Protects cron routes from unauthenticated execution
# Generate with: openssl rand -hex 32
CRON_SECRET=your-cron-secret-here

# OPTIONAL: Razorpay (disabled until KYC is complete — do NOT set fake keys)
# NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_live_xxx
# RAZORPAY_KEY_SECRET=your-razorpay-secret
# RAZORPAY_WEBHOOK_SECRET=your-webhook-secret

# OPTIONAL: SMS OTP (Fast2SMS or Twilio)
# FAST2SMS_API_KEY=your-key
# TWILIO_ACCOUNT_SID=your-sid
# TWILIO_AUTH_TOKEN=your-token
# TWILIO_FROM_NUMBER=+1234567890
